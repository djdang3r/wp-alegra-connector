# =============================================================================
# WordPress Plugin: Alegra Connector
# https://github.com/djdang3r/wp-alegra-connector
# =============================================================================

# -----------------------------------------------------------------------------
# Development artifacts (NEVER commit)
# -----------------------------------------------------------------------------
# Graphify static analyzer output
/graphify-out/

# Temporary test packages
/temp_pkg/

# Unit/integration tests (not yet implemented)
/tests/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Build artifacts (NEVER commit)
# -----------------------------------------------------------------------------
# Releases are tracked in this repo (binary files for distribution)
# Note: *.zip elsewhere is still excluded (see below)

# Compiled/optimized assets (if any)
/.cache/
/dist/
/build/

# -----------------------------------------------------------------------------
# Logs and debug files
# -----------------------------------------------------------------------------
*.log
*.log.*
*.tmp
*.bak
*.swp
*.pid
*.seed
*.pid.lock

# Debug output
debug.log
error.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage reports
coverage/
*.lcov
.nyc_output/

# -----------------------------------------------------------------------------
# Dependencies (Composer)
# -----------------------------------------------------------------------------
# If you add composer.json later:
/vendor/
composer.lock

# Node.js (if you add npm later)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# -----------------------------------------------------------------------------
# Environment files
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
config.local.php

# -----------------------------------------------------------------------------
# WordPress (in case any test files reference WP)
# -----------------------------------------------------------------------------
# Don't commit wp-config.php if it ever ends up here
/wp-config.php
/wp-content/

# -----------------------------------------------------------------------------
# IDE specific
# -----------------------------------------------------------------------------
# PHPStorm
.idea/
*.iml

# VSCode (selective - keep .vscode/launch.json for debug configs)
# .vscode/
.history/

# Eclipse
.project
.classpath
.settings/
bin/

# NetBeans
nb-configuration.xml
nbproject/

# -----------------------------------------------------------------------------
# OS specific
# -----------------------------------------------------------------------------
# Mac
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.Trash-*

# -----------------------------------------------------------------------------
# Backup files
# -----------------------------------------------------------------------------
*.bak
*.backup
*.old
*.orig
*.rej
*.swp
*~
*.tmp

# -----------------------------------------------------------------------------
# Archives (don't commit, regenerate via build process)
# -----------------------------------------------------------------------------
*.tar.gz
*.tar
*.tgz
*.rar
*.7z
*.dmg

# -----------------------------------------------------------------------------
# Sensitive data (NEVER commit credentials)
# -----------------------------------------------------------------------------
*.pem
*.key
*.crt
*.cer
.env.credentials
secrets.php
